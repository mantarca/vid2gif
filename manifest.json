{
  "manifest_version": 3,
  "name": "vid2gif - Ekran GIF Kaydedici",
  "version": "0.1.0",
  "description": "Ekranınızı, uygulama pencerelerini veya tarayıcı sekmelerini kaydedip optimize edilmiş animasyonlu GIF (.gif) olarak indirin.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "vid2gif - Ekran GIF Kaydedici",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "downloads"
  ]
}